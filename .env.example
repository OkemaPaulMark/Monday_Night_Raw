# These are DEV defaults. For docker-compose.prod.yml, set real values:
# DEBUG=False, a random SECRET_KEY, ALLOWED_HOSTS with your host/IP,
# and matching CORS_ALLOWED_ORIGINS.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# Database: SQLite only — no separate DB server. Defaults to backend/db.sqlite3;
# SQLITE_DB_PATH overrides where the file lives (used in docker-compose.prod.yml
# to point at a mounted volume).
# SQLITE_DB_PATH=/app/data/db.sqlite3

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed defaults
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
MIN_MATCH_PLAYERS=10
MAX_MATCH_PLAYERS=14
