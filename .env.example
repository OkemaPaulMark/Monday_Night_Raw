# These are DEV defaults. For docker-compose.prod.yml, set real values:
# DEBUG=False, a random SECRET_KEY, ALLOWED_HOSTS with your host/IP,
# a strong POSTGRES_PASSWORD, and matching CORS_ALLOWED_ORIGINS.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# Database
POSTGRES_DB=monday_night_raw
POSTGRES_USER=mnraw
POSTGRES_PASSWORD=mnraw_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://mnraw:mnraw_dev_password@localhost:5432/monday_night_raw

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed defaults
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
MIN_MATCH_PLAYERS=10
MAX_MATCH_PLAYERS=14
