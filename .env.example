# These are DEV defaults. For docker-compose.prod.yml, set real values:
# DEBUG=False, a random SECRET_KEY, ALLOWED_HOSTS with your host/IP,
# and matching CORS_ALLOWED_ORIGINS.

# Django
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver

# Database: SQLite only — no separate DB server. Defaults to backend/db.sqlite3;
# SQLITE_DB_PATH overrides where the file lives (used in docker-compose.prod.yml
# to point at a mounted volume).
# SQLITE_DB_PATH=/app/data/db.sqlite3

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# docker-compose.prod.yml only: host port the frontend container binds to.
# Defaults to 80 — set this if that port is already taken on the host (e.g.
# a system nginx serving other sites). Include the port in
# CORS_ALLOWED_ORIGINS above if you change it.
# FRONTEND_PORT=8080

# Seed defaults
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
